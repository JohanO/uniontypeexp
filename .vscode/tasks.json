{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build solution",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/UnionTypeExp.slnx"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "build apphost",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/UnionTypeExp.AppHost/UnionTypeExp.AppHost.csproj"
      ],
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "build server",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/UnionTypeExp.Server/UnionTypeExp.Server.csproj"
      ],
      "problemMatcher": [
        "$msCompile"
      ]
    }
  ]
}
